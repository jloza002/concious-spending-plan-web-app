# Backend API base URL. Used server-side by NextAuth's authorize() (calls
# /auth/login and /auth/refresh directly) and by next.config.ts's rewrite
# (/api/backend/:path* -> ${BACKEND_URL}/:path*). Baked in at build time.
BACKEND_URL="http://localhost:4000"

# NextAuth session-cookie secret. Independent of the backend's JWT_SECRET —
# this only encrypts NextAuth's own session, never the backend's tokens.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
AUTH_SECRET="replace-with-random-hex-string"

# Canonical URL of this deployment. Consumed implicitly by NextAuth v5.
NEXTAUTH_URL="http://localhost:3000"
