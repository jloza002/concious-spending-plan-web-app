# Database
DATABASE_URL="postgresql://user:password@localhost:5432/conscious_spending_plan"

# Auth
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET="replace-with-64-byte-random-hex-string"

# Encryption key for financial data at rest (AES-256-GCM)
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
# Leave blank to disable field-level encryption (not recommended for production)
ENCRYPTION_KEY=""

# Server
PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Feature flags
API_ENABLED=false

# Email (leave blank to use Ethereal preview in console for local dev)
# For production set these:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=your_api_key
# EMAIL_FROM=noreply@yourdomain.com
